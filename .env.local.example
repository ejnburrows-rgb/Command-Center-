# Copy to .env.local and fill in. Never commit real values.

# The only auth: one passphrase. Pick something long.
PORTAL_PASSPHRASE="change-me-to-a-long-passphrase"

# Fine-grained token, READ-ONLY, granted the 3 CRM repos:
#   Repository access: otto, cartilla-de-gretel, lany-books-web
#   Permissions: Metadata: Read · Issues: Read · Pull requests: Read · Contents: Read
GITHUB_TOKEN_READ="github_pat_..."

# Fine-grained token, granted ONLY command-center:
#   Repository access: command-center
#   Permissions: Metadata: Read · Contents: Read and write
GITHUB_TOKEN_WRITE="github_pat_..."
